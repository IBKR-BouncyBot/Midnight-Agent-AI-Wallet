// Local/Preprod TEST ONLY faucet. The token is not money or redeemable.
pragma language_version 0.23;
import CompactStandardLibrary;

export ledger mintCount: Counter;

export circuit mint(recipient: ZswapCoinPublicKey, amount: Uint<64>, nonce: Bytes<32>): [] {
  assert(amount > 0, "Positive mint amount required");
  mintShieldedToken(pad(32, "agent-vault:test-token:v1"), disclose(amount), disclose(nonce), left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)));
  mintCount.increment(1);
}
