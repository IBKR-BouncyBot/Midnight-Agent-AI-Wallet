# Example names only. Never commit actual values.
# Hex-encoded random 32-byte key from your local secret store.
WALLET_STORAGE_KEY=
# Explicit network for the local-only verification harness.
MIDNIGHT_NETWORK=
# Deployment references belong in trusted owner configuration, not model input.
WALLET_CONTRACT_ADDRESS=
WALLET_VAULT_ID=
# No hosted MCP listener, model API keys or remote tunnel is configured.

# Public demo always uses Preview. Loopback prover only; default port 16300.
MIDNIGHT_DEMO_PROOF_SERVER=http://127.0.0.1:16300
# Optional on Windows (defaults to current-user DPAPI); required on other OSes.
# At least 16 characters. Set in the process environment, never commit a value.
MIDNIGHT_DEMO_PASSWORD=

