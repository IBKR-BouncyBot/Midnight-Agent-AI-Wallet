{
  "name": "midnight-agent-ai-wallet",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "Confidential agent vault with browser and public Preview demos",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/serve-web.mjs --dist",
    "build:web": "node scripts/prepare-browser-artifacts.mjs && node scripts/build-web.mjs && node scripts/build-browser.mjs",
    "check:web": "node scripts/check-web.mjs",
    "demo:testnet": "node services/demo/server.mjs",
    "compile": "node scripts/compile.mjs",
    "compile:fast": "node scripts/compile.mjs --skip-zk",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/protocol.test.mjs tests/private-store.test.mjs tests/runner.test.mjs tests/demo-*.test.mjs tests/test-network-config.test.mjs tests/preview-evidence.test.mjs",
    "test:native": "node --test tests/native-*.test.mjs",
    "test:network": "node tests/network/private-vault.mjs",
    "test:network:durable": "node tests/network/durable-vault.mjs",
    "mcp:inspect": "node services/mcp/stdio.mjs",
    "agent:scripted": "node services/mcp/scripted-agent.mjs",
    "test:browser": "node --test tests/browser-*.test.mjs scripts/browser-prover-tests.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-prover-client": "1.2.3",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.2",
    "@midnight-ntwrk/zkir-v2": "2.1.1",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "bn.js": "5.2.5",
    "pino": "9.14.0",
    "rxjs": "7.8.2",
    "ws": "8.22.1"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/zkir-v2": "2.1.1"
  },
  "devDependencies": {
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "events": "3.3.0",
    "playwright": "1.64.1",
    "process": "0.11.10",
    "util": "0.12.5"
  }
}
